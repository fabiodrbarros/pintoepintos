# Porta e interface publicadas no anfitrião. Use 0.0.0.0 se o proxy estiver
# fora do anfitrião Docker; 127.0.0.1 é a opção segura para um proxy local.
PORT=3000
BIND_ADDRESS=127.0.0.1

ADMIN_USERNAME=admin
ADMIN_PASSWORD=altere-para-uma-palavra-passe-forte
ADMIN_SESSION_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# Para execução local sem Compose. No Compose, este valor é definido
# automaticamente para o serviço LibreTranslate.
TRANSLATION_API_URL=http://translate:5000

# Caminhos usados dentro do container. Só altere em execução local avançada.
DATABASE_PATH=/data/site.db
UPLOAD_DIR=/data/uploads
